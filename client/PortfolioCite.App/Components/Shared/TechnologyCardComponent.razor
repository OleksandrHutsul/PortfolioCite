<article class="technology-card" style="@AccentStyle">
    <div class="technology-card__icon" aria-hidden="true">
        <SkillIconMark Name="@Skill.IconName" />
    </div>
    <div class="technology-card__content">
        <div class="technology-card__title">
            <h3>@Skill.Name</h3>
            <span>@Skill.Badge</span>
        </div>
        <p>@Skill.Description</p>
    </div>
</article>
