@using PortfolioCite.Contracts.Portfolio.Models
@using PortfolioCite.Contracts.Portfolio.Rules

<label>
    <span>Icon<RequiredIndicatorComponent TValue="string" For="@ValueExpression" /></span>
    <AdminSelect TItem="SkillIcon"
                 Items="SkillIcons.All"
                 Value="@Value"
                 ValueChanged="@ValueChanged"
                 ItemValue="@(icon => icon.Name)"
                 ItemLabel="@(icon => icon.Label)"
                 Placeholder="Select an icon"
                 MenuLabel="Icon"
                 Invalid="IsInvalid">
        <ItemTemplate Context="icon">
            <span class="skill-icon-choice">
                <SkillIconMark Icon="icon" />
                <span class="skill-icon-choice__label">@icon.Label</span>
            </span>
        </ItemTemplate>
        <SelectedTemplate>
            <span class="skill-icon-choice">
                <SkillIconMark Name="@Value" />
                <span class="skill-icon-choice__label">@SelectedLabel</span>
            </span>
        </SelectedTemplate>
        <LeadingContent>
            @if (Selected is null && !string.IsNullOrWhiteSpace(Value))
            {
                <div class="admin-select__option is-unsupported" role="option" aria-selected="true">
                    <span class="skill-icon-choice">
                        <SkillIconMark Name="@Value" />
                        <span class="skill-icon-choice__label">@SelectedLabel</span>
                    </span>
                </div>
            }
        </LeadingContent>
    </AdminSelect>

    <div class="admin-field-message">
        <ValidationMessage For="@ValueExpression" />
    </div>
</label>
