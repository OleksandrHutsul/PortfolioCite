@page "/admin/projects"
@attribute [Authorize(Policy = "PortfolioAdmin")]
@layout AdminLayout

<header class="admin-page-header">
    <div>
        <p>Content</p>
        <h1>Projects</h1>
        <span>Choose which projects appear on the home page. At most 3 can be shown there.</span>
    </div>

    <a class="admin-primary-action" href="/admin/projects/new">Add project</a>
</header>

@if (IsLoading)
{
    <LoadingSkeletonComponent Variant="list" Count="4" />
}
else if (Error is not null && Projects.Count == 0)
{
    <ErrorStateComponent Title="Unable to load projects"
                         Description="@Error"
                         OnRetry="LoadAsync"
                         IsRetrying="IsLoading" />
}
else if (Projects.Count == 0)
{
    <EmptyStateComponent Title="No projects yet"
                         Description="Create the first project to get started." />
}
else
{
    @if (Error is not null)
    {
        <div class="admin-form-error" role="alert">@Error</div>
    }

    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Project</th>
                    <th>Technologies</th>
                    <th>Home page</th>
                    <th>Order</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var project in Projects)
                {
                    <tr>
                        <td>
                            <strong>@project.Name</strong>
                            <small>@project.ShortDescription</small>
                        </td>
                        <td>
                            <div class="admin-tags">
                                @foreach (var technology in project.Technologies)
                                {
                                    <span>@technology</span>
                                }
                            </div>
                        </td>
                        <td>
                            <button class="status-pill @(project.IsPublished ? "visible" : "hidden")"
                                    title="@(project.IsPublished ? "Shown on the home page" : "Not shown on the home page")"
                                    @onclick="() => ToggleVisibilityAsync(project)"
                                    disabled="@IsSaving">
                                @(project.IsPublished ? "Visible" : "Hidden")
                            </button>
                        </td>
                        <td>@project.DisplayOrder</td>
                        <td class="admin-row-actions">
                            <a href="@($"/admin/projects/{project.Id}")">Edit</a>
                            <button @onclick="() => DeleteAsync(project)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
