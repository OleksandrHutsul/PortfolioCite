@page "/admin/projects/new"
@page "/admin/projects/{Id:int}"
@attribute [Authorize(Policy = "PortfolioAdmin")]
@layout AdminLayout

<header class="admin-page-header">
    <div>
        <p>Projects</p>
        <h1>@(Id is null ? "Create project" : "Edit project")</h1>
    </div>

    <a class="admin-secondary-action" href="/admin/projects">Back to projects</a>
</header>

@if (IsLoading)
{
    <LoadingSkeletonComponent Variant="list" Count="3" />
}
else if (LoadError is not null)
{
    <ErrorStateComponent Title="Unable to load the project"
                         Description="@LoadError"
                         OnRetry="LoadAsync"
                         IsRetrying="IsLoading" />
}
else
{
    <EditForm Model="Request" OnValidSubmit="SaveAsync" class="admin-form">
        <DataAnnotationsValidator />

        <div class="admin-form-grid">
            <label class="wide">
                <span>Name<RequiredIndicatorComponent For="@(() => Request.Name)" /></span>
                <InputText @bind-Value="Request.Name" />
                <ValidationMessage For="@(() => Request.Name)" />
            </label>

            <label class="wide">
                <span>Short description<RequiredIndicatorComponent For="@(() => Request.ShortDescription)" /></span>
                <InputText @bind-Value="Request.ShortDescription" />
                <ValidationMessage For="@(() => Request.ShortDescription)" />
            </label>

            <label class="wide">
                <span>Description<RequiredIndicatorComponent For="@(() => Request.Description)" /></span>
                <InputTextArea @bind-Value="Request.Description" rows="7" />
                <ValidationMessage For="@(() => Request.Description)" />
            </label>

            <label>
                <span>GitHub URL<RequiredIndicatorComponent For="@(() => Request.GitHubUrl)" /></span>
                <InputText @bind-Value="Request.GitHubUrl" />
                <ValidationMessage For="@(() => Request.GitHubUrl)" />
            </label>

            <label>
                <span>Live URL<RequiredIndicatorComponent For="@(() => Request.LiveUrl)" /></span>
                <InputText @bind-Value="Request.LiveUrl" />
                <ValidationMessage For="@(() => Request.LiveUrl)" />
            </label>

            <section class="admin-media" aria-labelledby="project-image-heading">
                <h2 id="project-image-heading">Project image</h2>

                <div class="admin-media__body">
                    <div class="admin-media__mark @(ImageRemovePending ? "is-removed" : null)">
                        @if (ShowProjectImage)
                        {
                            <img src="@ImagePreviewUrl" alt="@ImageAlt" />
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <rect x="3.5" y="5" width="17" height="14" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.5" />
                                <circle cx="8.5" cy="9.5" r="1.4" fill="none" stroke="currentColor" stroke-width="1.5" />
                                <path d="M4.5 16.5l4.2-3.4 2.6 2.1 3.1-3.7 5.1 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        }
                    </div>

                    <div class="admin-media__copy">
                        <p class="admin-media__status">@ImageStatus</p>

                        @if (ImageDetail is not null)
                        {
                            <p class="admin-media__meta">@ImageDetail</p>
                        }

                        <div class="admin-media__actions">
                            <div class="admin-file-button @(IsSaving ? "is-disabled" : null)">
                                <label for="project-image">@ImageActionLabel</label>
                                <InputFile id="project-image"
                                           @key="ImageInputVersion"
                                           class="media-file-input"
                                           OnChange="SelectImageAsync"
                                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                           aria-label="@ImageActionLabel" />
                            </div>

                            @if (HasPendingImage)
                            {
                                <button type="button" class="admin-text-button" disabled="@IsSaving" @onclick="ClearImageSelection">Clear</button>
                            }
                            else if (ImageRemovePending)
                            {
                                <button type="button" class="admin-text-button" disabled="@IsSaving" @onclick="UndoImageRemoval">Undo</button>
                            }
                            else if (HasStoredImage)
                            {
                                <button type="button" class="admin-text-button" disabled="@IsSaving" @onclick="MarkImageForRemoval">Remove image</button>
                            }
                        </div>

                        <p class="admin-media__hint">@ImageHint</p>

                        @if (ImageMessage is not null)
                        {
                            <p class="admin-media__error" role="alert">@ImageMessage</p>
                        }
                    </div>
                </div>
            </section>

            <DisplayOrderField @bind-Value="Request.DisplayOrder" ItemCount="OrderItemCount" />

            <label class="wide">
                <span>Technologies<RequiredIndicatorComponent For="@(() => Request.Technologies)" /></span>
                <span class="admin-field-control">
                    <InputText @bind-Value="TechnologyNames" />
                    <small>Comma-separated, for example: ASP.NET Core, Blazor, PostgreSQL</small>
                </span>
                <ValidationMessage For="@(() => Request.Technologies)" />
            </label>

            <label class="admin-checkbox wide">
                <InputCheckbox @bind-Value="Request.IsPublished" />
                <span class="admin-field-control">
                    <span>Show on home page</span>
                    <small>Controls the home page only. Hidden projects still appear in the full project catalogue. At most 3 can be shown on the home page.</small>
                </span>
            </label>
        </div>

        @if (SaveError is not null)
        {
            <div class="admin-form-error" role="alert">@SaveError</div>
        }

        <div class="admin-form-actions">
            <button type="submit" disabled="@IsSaving">
                @(IsSaving ? "Saving…" : "Save project")
            </button>
            <a href="/admin/projects">Cancel</a>
        </div>
    </EditForm>
}
