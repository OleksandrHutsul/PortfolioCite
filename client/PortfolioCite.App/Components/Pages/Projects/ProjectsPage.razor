@page "/projects"

<section class="projects-page section-reveal">
    <SectionTitleComponent Eyebrow="Projects" Title="All projects" />

    @if (IsLoading)
    {
        <LoadingSkeletonComponent Variant="cards" Count="3" />
    }
    else if (LoadError is not null)
    {
        <ErrorStateComponent Title="Unable to load projects"
                             Description="The project catalogue is temporarily unavailable."
                             IsRetrying="IsLoading"
                             OnRetry="LoadAsync" />
    }
    else if (Projects.Count == 0)
    {
        <EmptyStateComponent Title="No projects yet"
                             Description="New work will appear here once it is added." />
    }
    else
    {
        <div class="projects-grid">
            @foreach (var project in Projects.OrderBy(item => item.DisplayOrder))
            {
                <ProjectCardComponent Project="project" />
            }
        </div>
    }
</section>
